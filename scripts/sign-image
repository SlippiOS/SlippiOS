#!/usr/bin/env bash
# Sign a SlippiOS image with the Fedora shim and a SlippiOS MOK key.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}"
SHIM_VERSION="16.1-7"
SHIM_RPM_URL="https://download.fedoraproject.org/pub/fedora/linux/updates/44/Everything/x86_64/Packages/s/shim-x64-${SHIM_VERSION}.x86_64.rpm"
SHIM_RPM_SHA256="4badee0c00c4c41a53f41c8a2dd566dca815ca051f1d2fba92490d0a0194f5c3"
SHIM_SHA256="351e131d3c4a636704e9cae7d1296baf8a05beca9922cfebbfa48933c9bf1ad3"
MOK_MANAGER_SHA256="ed4442fa88cccba3a9e6a32d21a8f4c56bf5aab184f1fb9aadde8d3a9d04dc27"
SHIM_RPM="$CACHE/secureboot/shim-x64-${SHIM_VERSION}.x86_64.rpm"
SHIM_ROOT="$CACHE/secureboot/shim-${SHIM_VERSION}"

usage() {
  cat <<'USAGE'
usage: scripts/sign-image <unsigned.raw> <signed.raw>

Environment:
  SLIPPIOS_SB_KEY    PEM private key for systemd-boot and the UKI
  SLIPPIOS_SB_CERT   PEM certificate for the same key
  SLIPPIOS_CACHE     cache root (default .cache)

Run inside a shell with sbsigntool, mtools, rpm, cpio, parted, and openssl.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi
if [[ $# -ne 2 ]]; then
  usage >&2
  exit 2
fi

image=$1
output=$2
key="${SLIPPIOS_SB_KEY:-}"
cert="${SLIPPIOS_SB_CERT:-}"

if [[ -z "$key" || -z "$cert" ]]; then
  echo "set SLIPPIOS_SB_KEY and SLIPPIOS_SB_CERT" >&2
  exit 2
fi
if [[ ! -f "$image" || ! -f "$key" || ! -f "$cert" ]]; then
  echo "image, key, and certificate must exist" >&2
  exit 1
fi
if [[ "$(realpath "$image")" == "$(realpath "$output")" ]]; then
  echo "input and output must differ" >&2
  exit 1
fi

for tool in curl sbsign sbverify mcopy mdir mdel mmd parted rpm2cpio cpio sha256sum openssl; do
  command -v "$tool" >/dev/null || {
    echo "$tool is required" >&2
    exit 1
  }
done

mkdir -p "$CACHE/secureboot"

if [[ ! -f "$SHIM_RPM" ]]; then
  curl --fail --location --output "$SHIM_RPM.tmp" "$SHIM_RPM_URL"
  echo "$SHIM_RPM_SHA256  $SHIM_RPM.tmp" | sha256sum -c -
  mv "$SHIM_RPM.tmp" "$SHIM_RPM"
fi
echo "$SHIM_RPM_SHA256  $SHIM_RPM" | sha256sum -c -

shim="$SHIM_ROOT/usr/lib/efi/shim/$SHIM_VERSION/EFI/fedora/shimx64.efi"
mok_manager="$SHIM_ROOT/usr/lib/efi/shim/$SHIM_VERSION/EFI/fedora/mmx64.efi"
if [[ ! -f "$shim" || ! -f "$mok_manager" ]]; then
  rm -rf "$SHIM_ROOT"
  mkdir -p "$SHIM_ROOT"
  (cd "$SHIM_ROOT" && rpm2cpio "$SHIM_RPM" | cpio -idm --quiet)
fi
echo "$SHIM_SHA256  $shim" | sha256sum -c -
echo "$MOK_MANAGER_SHA256  $mok_manager" | sha256sum -c -

shim_signers=$(sbverify --list "$shim" 2>/dev/null)
grep -q "Microsoft Corporation UEFI CA 2011" <<<"$shim_signers"
grep -q "Microsoft UEFI CA 2023" <<<"$shim_signers"

offset=$(parted -s -m "$image" unit B print | awk -F: '$6 == "boot" {gsub("B", "", $2); print $2; exit}')
if [[ -z "$offset" ]]; then
  echo "cannot find the ESP partition" >&2
  exit 1
fi

work=$(mktemp -d "$CACHE/secureboot/work.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/uki"

mcopy -i "$image@@$offset" ::/EFI/BOOT/BOOTX64.EFI "$work/systemd-boot.efi"
mcopy -i "$image@@$offset" "::/EFI/Linux/*.efi" "$work/uki/"
if [[ -z "$(find "$work/uki" -maxdepth 1 -type f -name '*.efi' -print -quit)" ]]; then
  echo "cannot find a UKI in the ESP" >&2
  exit 1
fi

if sbverify --list "$work/systemd-boot.efi" 2>/dev/null | grep -q "Microsoft Corporation UEFI CA"; then
  echo "input image is already signed; use the unsigned image" >&2
  exit 1
fi

mkdir -p "$(dirname "$output")"
if ! cp --reflink=auto --sparse=always "$image" "$output" 2>/dev/null; then
  cp --sparse=always "$image" "$output"
fi
chmod u+w "$output"

sbsign --key "$key" --cert "$cert" \
  --output "$work/systemd-boot.signed.efi" "$work/systemd-boot.efi"
sbverify --cert "$cert" "$work/systemd-boot.signed.efi"

for uki in "$work/uki"/*.efi; do
  name=$(basename "$uki")
  sbsign --key "$key" --cert "$cert" \
    --output "$work/uki/$name.signed" "$uki"
  sbverify --cert "$cert" "$work/uki/$name.signed"
  mcopy -i "$output@@$offset" -o "$work/uki/$name.signed" "::/EFI/Linux/$name"
done

openssl x509 -in "$cert" -outform DER -out "$work/slippios.cer"

mcopy -i "$output@@$offset" -o "$shim" ::/EFI/BOOT/BOOTX64.EFI
mcopy -i "$output@@$offset" -o "$work/systemd-boot.signed.efi" ::/grubx64.efi
mcopy -i "$output@@$offset" -o "$work/systemd-boot.signed.efi" ::/EFI/BOOT/grubx64.efi
mcopy -i "$output@@$offset" -o "$mok_manager" ::/mmx64.efi
mcopy -i "$output@@$offset" -o "$mok_manager" ::/EFI/BOOT/mmx64.efi
mcopy -i "$output@@$offset" -o "$work/slippios.cer" ::/slippios.cer
mcopy -i "$output@@$offset" -o "$work/slippios.cer" ::/EFI/BOOT/slippios.cer
mdel -i "$output@@$offset" ::/EFI/BOOT/fbx64.efi 2>/dev/null || true

mmd -i "$output@@$offset" ::/EFI/systemd 2>/dev/null || true
mcopy -i "$output@@$offset" -o "$work/systemd-boot.signed.efi" ::/EFI/systemd/systemd-bootx64.efi
mcopy -i "$output@@$offset" -o secure-boot/ENROLL.txt ::/SECUREBOOT.txt
mcopy -i "$output@@$offset" -o secure-boot/LICENSE.shim ::/SHIM-LICENSE.txt

echo "Signed image: $output"
echo "ESP offset:   $offset"
echo "First boot:   enroll slippios.cer in MOK"
