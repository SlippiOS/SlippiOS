#!/usr/bin/env bash
# Reusable SlippiOS USB flasher.
#
#   scripts/flash-usb              # detect, confirm, configure, flash
#   scripts/flash-usb status       # show helper, device, image, and USB media
#   scripts/flash-usb disable      # remove the passwordless helper
#   scripts/flash-usb enable ...   # advanced: install the helper without flashing
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CONFIG="/etc/slippios/flash.conf"
HELPER="/usr/local/sbin/slippios-flash"
SUDOERS="/etc/sudoers.d/slippios-flash"
DEFAULT_IMAGE_DIR="$PWD/.cache/release-dev"

usage() {
  cat <<'USAGE'
usage: scripts/flash-usb [flash] [options]

  (none)    detect USB media, confirm, configure the helper if needed, flash
  flash     same as no argument
  status    show the configured device, image, helper, and USB media
  disable   remove the helper, sudoers rule, and config
  enable    advanced: install/update the helper without flashing
            options: --device PATH --image-dir DIR --allow-fixed

Flash options:
  --device PATH    skip detection and use this device
  --image-dir DIR  use a different signed image directory
  --yes            skip the confirmation
  --dry-run        show the selected device and image, then exit

Environment:
  FLASH_USER  user allowed to run the helper (default: SUDO_USER)
USAGE
}

by_id_for() {
  local dev=$1 name link
  name=$(basename "$(readlink -f "$dev")")
  for link in /dev/disk/by-id/usb-*; do
    [[ -e "$link" ]] || continue
    if [[ "$(readlink -f "$link")" == "/dev/$name" ]]; then
      printf '%s\n' "$link"
      return 0
    fi
  done
  printf '%s\n' "/dev/$name"
}

usb_label_for() {
  local dev=$1 name
  name=$(basename "$(readlink -f "$dev")")
  udevadm info --query=property --name="/dev/$name" 2>/dev/null |
    awk -F= '
      /^ID_VENDOR_ID=/{vid=$2}
      /^ID_MODEL_ID=/{mid=$2}
      /^ID_VENDOR=/{vendor=$2}
      /^ID_MODEL=/{model=$2}
      END {
        gsub("_", " ", model);
        if (vid && mid) {
          if (vendor != "" && model != "") printf "%s %s (%s:%s)", vendor, model, vid, mid;
          else printf "(%s:%s)", vid, mid;
        }
      }'
}

detect_usb() {
  local allow_fixed=${1:-0}
  local filter='$2 == 1 && $3 == "usb"'
  if [[ "$allow_fixed" == "1" ]]; then
    filter='$3 == "usb"'
  fi
  local usb=()
  mapfile -t usb < <(lsblk -dno NAME,RM,TRAN | awk "$filter {print \$1}")
  if [[ ${#usb[@]} -eq 0 ]]; then
    echo "no USB disk found" >&2
    [[ "$allow_fixed" != "1" ]] && echo "for a USB NVMe enclosure, pass --allow-fixed" >&2
    return 1
  fi
  if [[ ${#usb[@]} -gt 1 ]]; then
    echo "multiple USB disks found; pass --device with enable" >&2
    printf '  /dev/%s\n' "${usb[@]}" >&2
    return 1
  fi
  by_id_for "/dev/${usb[0]}"
}

list_usb_media() {
  lsblk -J -d -o NAME,SIZE,MODEL,TRAN,RM 2>/dev/null |
    jq -r '.blockdevices[] | select(.tran == "usb") |
      [.name, .size, ((.model // "") | gsub(" +$"; "")), ((.rm // false) | tostring)] | @tsv'
}

choose_device() {
  local media=()
  mapfile -t media < <(list_usb_media)
  if [[ ${#media[@]} -eq 0 ]]; then
    echo "No USB flash media detected. Connect the drive and retry." >&2
    return 1
  fi

  local name size model rm dev label fixed
  if [[ ${#media[@]} -eq 1 ]]; then
    IFS=$'\t' read -r name size model rm <<< "${media[0]}"
    dev="/dev/$name"
    label=$(usb_label_for "$dev")
    fixed=""
    [[ "$rm" != "true" ]] && fixed=", fixed"
    printf 'Detected USB media: %s  %s  %s%s%s\n' \
      "$dev" "$size" "$model" "${label:+ [$label]}" "$fixed" >&2
    by_id_for "$dev"
    return 0
  fi

  echo "USB media:" >&2
  local index=1
  for entry in "${media[@]}"; do
    IFS=$'\t' read -r name size model rm <<< "$entry"
    dev="/dev/$name"
    label=$(usb_label_for "$dev")
    fixed=""
    [[ "$rm" != "true" ]] && fixed=", fixed"
    printf '  %d) %s  %s  %s%s%s\n' \
      "$index" "$dev" "$size" "$model" "${label:+ [$label]}" "$fixed" >&2
    index=$((index + 1))
  done
  printf 'Select device [1-%d] (q to cancel): ' "${#media[@]}" >&2
  local choice
  read -r choice
  [[ "$choice" == "q" || -z "$choice" ]] && return 1
  [[ "$choice" =~ ^[0-9]+$ ]] || return 1
  (( choice >= 1 && choice <= ${#media[@]} )) || return 1
  IFS=$'\t' read -r name size model rm <<< "${media[$((choice - 1))]}"
  by_id_for "/dev/$name"
}

image_for() {
  local dir=$1
  local images=()
  mapfile -t images < <(find -L "$dir" -maxdepth 1 -type f \
    -name 'slippios_*.raw' ! -name '*.nix-store.raw' -print 2>/dev/null)
  if [[ ${#images[@]} -ne 1 ]]; then
    echo "expected one signed dev image in $dir, found ${#images[@]}" >&2
    echo "run: scripts/release-dev --keep-raw" >&2
    return 1
  fi
  printf '%s\n' "${images[0]}"
}

configure() {
  local target_dev=$1 target_image_dir=$2 target_allow_fixed=$3
  local cfg_device="" cfg_image_dir="" cfg_allow_fixed=0
  if [[ -r "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
    cfg_device=${device:-}
    cfg_image_dir=${image_dir:-}
    cfg_allow_fixed=${allow_fixed:-0}
  fi
  if [[ "$cfg_device" == "$target_dev" &&
        "$cfg_image_dir" == "$target_image_dir" &&
        "$cfg_allow_fixed" == "$target_allow_fixed" &&
        -x "$HELPER" ]]; then
    return 0
  fi
  local args=(enable --device "$target_dev" --image-dir "$target_image_dir")
  [[ "$target_allow_fixed" == "1" ]] && args+=(--allow-fixed)
  sudo "$(readlink -f "$0")" "${args[@]}"
}

flash() {
  if [[ ! -x "$HELPER" ]]; then
    echo "flash helper is not installed" >&2
    exit 1
  fi
  if [[ ! -r "$CONFIG" ]]; then
    echo "flash config is missing" >&2
    exit 1
  fi
  sudo -n "$HELPER"
}

flash_interactive() {
  local device=""
  local image_dir="$DEFAULT_IMAGE_DIR"
  local yes=0 dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --device) device="${2:?missing device}"; shift ;;
      --image-dir) image_dir="${2:?missing image directory}"; shift ;;
      --yes) yes=1 ;;
      --dry-run) dry_run=1 ;;
      *) echo "unknown flash option: $1" >&2; exit 2 ;;
    esac
    shift
  done

  local image
  image=$(image_for "$image_dir") || exit 1
  if [[ -z "$device" ]]; then
    device=$(choose_device) || exit 1
  fi

  local dev name rm allow_fixed label size model
  dev=$(readlink -f "$device")
  name=$(basename "$dev")
  rm=$(cat "/sys/block/$name/removable" 2>/dev/null || echo 0)
  allow_fixed=0
  [[ "$rm" != "1" ]] && allow_fixed=1
  label=$(usb_label_for "$dev")
  size=$(lsblk -dno SIZE "$dev" 2>/dev/null || true)
  model=$(lsblk -dno MODEL "$dev" 2>/dev/null | sed 's/[[:space:]]*$//' || true)

  if [[ "$yes" -ne 1 ]]; then
    printf 'Image:  %s\n' "$image"
    printf 'Target: %s  %s  %s%s\n' "$dev" "$size" "$model" "${label:+ [$label]}"
    printf 'This will ERASE %s. Continue? [y/N] ' "$dev"
    local answer
    read -r answer
    [[ "$answer" =~ ^[Yy]$ ]] || {
      echo "Cancelled."
      exit 1
    }
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    printf 'Would flash %s to %s (allow_fixed=%s).\n' "$image" "$dev" "$allow_fixed"
    return 0
  fi

  configure "$device" "$image_dir" "$allow_fixed"
  flash
}

enable() {
  local device=""
  local image_dir="$DEFAULT_IMAGE_DIR"
  local allow_fixed=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --device) device="${2:?missing device}"; shift ;;
      --image-dir) image_dir="${2:?missing image directory}"; shift ;;
      --allow-fixed) allow_fixed=1 ;;
      *) echo "unknown enable option: $1" >&2; exit 2 ;;
    esac
    shift
  done

  if [[ $EUID -ne 0 ]]; then
    local args=(enable --image-dir "$image_dir")
    [[ -n "$device" ]] && args+=(--device "$device")
    [[ "$allow_fixed" -eq 1 ]] && args+=(--allow-fixed)
    exec sudo "$(readlink -f "$0")" "${args[@]}"
  fi

  local user="${FLASH_USER:-${SUDO_USER:-}}"
  if [[ -z "$user" ]]; then
    echo "run this through sudo from your user account" >&2
    exit 1
  fi
  if [[ -z "$device" ]]; then
    device=$(detect_usb "$allow_fixed")
  fi
  image_for "$image_dir" >/dev/null

  install -d -o root -g root -m 0755 /etc/slippios
  cat > "$CONFIG" <<EOF
device="$device"
image_dir="$image_dir"
allow_fixed="$allow_fixed"
EOF
  chmod 0644 "$CONFIG"
  install -o root -g root -m 0755 scripts/flash-usb-helper "$HELPER"
  cat > "$SUDOERS" <<EOF
$user ALL=(root) NOPASSWD: $HELPER
EOF
  chmod 0440 "$SUDOERS"
  visudo -c >/dev/null
  echo "Enabled for $user"
  echo "Device: $device"
  echo "Images: $image_dir"
  echo "Flash with: scripts/flash-usb"
}

disable() {
  if [[ $EUID -ne 0 ]]; then
    exec sudo "$(readlink -f "$0")" disable
  fi
  rm -f "$SUDOERS" "$HELPER" "$CONFIG"
  visudo -c >/dev/null
  echo "Disabled the passwordless flash helper."
}

status() {
  echo "Helper:  $([[ -x "$HELPER" ]] && echo installed || echo missing)"
  if sudo -n -l "$HELPER" >/dev/null 2>&1; then
    echo "Sudoers: installed"
  else
    echo "Sudoers: missing"
  fi
  if [[ -r "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
    echo "Device:  ${device:-missing}"
    echo "Images:  ${image_dir:-missing}"
    echo "Allow fixed: $([[ "${allow_fixed:-0}" == "1" ]] && echo yes || echo no)"
    image_for "$image_dir" 2>/dev/null | sed 's/^/Image:   /' || true
  else
    echo "Config:  missing"
  fi
  echo "USB:"
  local media=()
  mapfile -t media < <(list_usb_media)
  local name size model rm dev label fixed
  for entry in "${media[@]}"; do
    IFS=$'\t' read -r name size model rm <<< "$entry"
    dev="/dev/$name"
    label=$(usb_label_for "$dev")
    fixed=""
    [[ "$rm" != "true" ]] && fixed=", fixed"
    printf '  %s  %s  %s%s%s\n' "$dev" "$size" "$model" "${label:+ [$label]}" "$fixed"
  done
}

case "${1:-}" in
  enable) shift; enable "$@" ;;
  disable) shift; disable "$@" ;;
  status) status ;;
  flash) shift; flash_interactive "$@" ;;
  -h|--help) usage ;;
  --device|--image-dir|--yes|--dry-run) flash_interactive "$@" ;;
  "") flash_interactive ;;
  *) echo "unknown action: $1" >&2; usage >&2; exit 2 ;;
esac
