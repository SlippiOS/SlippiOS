#!/usr/bin/env bash
# Upload the full USB images and license files to SourceForge.
#
# SourceForge hosts the install media. R2 hosts only the update assets.
# Usage:
#   scripts/publish-sourceforge ASSETS_DIR SOURCEFORGE_USER
#   SF_USER=name scripts/publish-sourceforge ASSETS_DIR
# Add the SSH public key from SF_KEY (default ~/.ssh/sourceforge_slippios)
# to your SourceForge account first.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

assets=${1:?usage: scripts/publish-sourceforge ASSETS_DIR SOURCEFORGE_USER}
user=${SF_USER:-${2:-}}
if [[ -z "$user" ]]; then
  echo "usage: scripts/publish-sourceforge ASSETS_DIR SOURCEFORGE_USER" >&2
  echo "   or: SF_USER=name scripts/publish-sourceforge ASSETS_DIR" >&2
  echo "fish: scripts/publish-sourceforge ASSETS_DIR name" >&2
  exit 1
fi
project=${SF_PROJECT:-slippi-os}
key=${SF_KEY:-$HOME/.ssh/sourceforge_slippios}
version=$(jq -r .version "$assets/manifest.json")
remote="/home/frs/project/$project/v$version"
target="$user@frs.sourceforge.net:$remote"

if [[ ! -f "$key" ]]; then
  echo "missing SSH key $key" >&2
  exit 1
fi

files=(
  "$assets/slippios-usb-$version.img.xz"
  "$assets/slippios-usb-$version-unsigned.img.xz"
  "$assets/SHA256SUMS"
  "$assets/LICENSE"
  "$assets/NOTICE"
  "$assets/THIRD_PARTY_LICENSES.md"
  "$assets/SOURCE"
  "$assets/README.md"
  "$assets/LICENSES.tar.gz"
)
for file in "${files[@]}"; do
  if [[ ! -f "$file" ]]; then
    echo "missing $file" >&2
    exit 1
  fi
done

signed_file="$assets/slippios-usb-$version.img.xz"
support=()
for file in "${files[@]}"; do
  [[ "$file" == "$signed_file" ]] && continue
  support+=("$file")
done

# The FRS account is a restricted shell: it only accepts file-transfer
# commands. Use SFTP to create the release directory, then rsync the files.
if ! sftp -q -b - -i "$key" -o StrictHostKeyChecking=accept-new \
  "$user@frs.sourceforge.net" >/dev/null 2>&1 <<EOF
ls /home/frs/project/$project
EOF
then
  echo "SourceForge project '$project' not found." >&2
  echo "Create it at https://sourceforge.net/create/ and wait for approval." >&2
  exit 1
fi

if ! sftp -q -b - -i "$key" -o StrictHostKeyChecking=accept-new \
  "$user@frs.sourceforge.net" >/dev/null 2>&1 <<EOF
-mkdir /home/frs/project/$project/v$version
ls /home/frs/project/$project/v$version
EOF
then
  echo "Could not create /home/frs/project/$project/v$version." >&2
  echo "Create the v$version folder in the SourceForge file manager, then rerun." >&2
  exit 1
fi

rsync -avP -e "ssh -i $key -o StrictHostKeyChecking=accept-new" \
  "${support[@]}" "$target/"

# Upload the signed image last. Do not preserve its mtime: SourceForge's
# "latest" heuristic otherwise picks whichever license file has the newest
# local timestamp. The authoritative fix is still "Default download for" in
# the SourceForge file manager.
rsync -avP --no-times -e "ssh -i $key -o StrictHostKeyChecking=accept-new" \
  "$signed_file" "$target/"

echo
echo "Uploaded to https://sourceforge.net/projects/$project/files/v$version/"
echo "The signed image was uploaded last; set it as the default download in the SourceForge file manager."
