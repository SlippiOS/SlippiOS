#!/usr/bin/env bash
# Build the SlippiOS USB image locally.
#
# Prefers a normal Nix installation. If Nix is not installed, uses
# nix-portable with bubblewrap. The latter needs a real-disk TMPDIR because
# the raw image is ~6 GB and /tmp is often a small tmpfs.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}"
BUILD_TMP="${SLIPPI_TMPDIR:-$CACHE/build-tmp}"
OUT="${SLIPPI_RESULT:-result-local-image}"
JOBS="${SLIPPI_JOBS:-$(( $(nproc 2>/dev/null || echo 4) > 8 ? 8 : $(nproc 2>/dev/null || echo 4) ))}"
# Local boot tests do not need the compressed release artifact.
if [[ -n "${SLIPPI_CONFIG:-}" ]]; then
  CONFIG="$SLIPPI_CONFIG"
elif [[ "${SLIPPI_DEV:-0}" == "1" ]]; then
  CONFIG=slippios-usb-dev
else
  CONFIG=slippios-usb
fi

mkdir -p "$BUILD_TMP"
export TMPDIR="$BUILD_TMP"

build() {
  local nix_cmd=("$@")
  "${nix_cmd[@]}" build \
    --option extra-substituters https://cache.lantian.pub/lantian \
    --option extra-trusted-public-keys 'lantian:WVGO7vsRMSEN+h7Lp7kv6SAmrkEXgUGbbXm7jMDjBuQ=' \
    --print-build-logs \
    --cores "$JOBS" \
    --max-jobs 1 \
    ".#nixosConfigurations.$CONFIG.config.system.build.image" \
    -o "$OUT"
}

rm -f "$OUT"

old_target=""
if [[ "$CONFIG" == "slippios-usb-dev" && -e "$OUT" ]]; then
  old_target=$(readlink "$OUT" || true)
fi

if command -v nix >/dev/null 2>&1; then
  echo "Building with system Nix ($JOBS cores)..."
  build nix
else
  echo "Building with nix-portable/bwrap ($JOBS cores)..."
  echo "  TMPDIR: $BUILD_TMP"
  build ./scripts/nix

fi

echo
if [[ "$CONFIG" == "slippios-usb-dev" ]]; then
  echo "Dev build: image is uncompressed."
fi
# Rewrite nix-portable's in-container store paths to the project-local store.
target=$(readlink "$OUT" 2>/dev/null || true)
if [[ "$target" == /nix/store/* && ! -e "$target" && -d "$CACHE/nix$target" ]]; then
  target="$CACHE/nix$target"
fi
# Keep result links on the physical store.
target=${target/"$CACHE/.nix-portable"/"$CACHE/nix"}
if [[ -n "$target" && -e "$target" ]]; then
  ln -sfn "$target" "$OUT"
fi

if [[ "$CONFIG" == "slippios-usb-dev" && -n "$old_target" &&
      "$old_target" != "$(readlink "$OUT")" ]]; then
  echo "Pruning previous dev image: $old_target"
  if command -v nix >/dev/null 2>&1; then
    nix store delete "$old_target" >/dev/null 2>&1 || true
  else
    ./scripts/nix store delete "$old_target" >/dev/null 2>&1 || true
  fi
fi

echo "Artifacts:"
find -L "$OUT" -maxdepth 1 -type f -printf '  %f  %s bytes\n' | sort
