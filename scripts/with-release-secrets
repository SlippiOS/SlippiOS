#!/usr/bin/env bash
# Run a release, signing, or publish command with the SlippiOS release secrets
# in its environment.
#
# The Secure Boot key is resolved in this order:
#   1. SLIPPIOS_SB_KEY / SLIPPIOS_SB_CERT from the environment
#   2. ~/.config/slippios/secureboot/slippios.key
#   3. the encrypted ~/.secrets copies from chezmoi, on personal machines
#   4. the private release-secrets vault, decrypted into tmpfs for this command
#
# Usage:
#   scripts/with-release-secrets [--vault] <command> [args...]
#   scripts/with-release-secrets [--vault] --check
#   scripts/with-release-secrets --publish <command> [args...]
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
secrets_dir="${SLIPPIOS_RELEASE_SECRETS:-$HOME/.config/slippios/release-secrets}"
identity="${SLIPPIOS_RELEASE_AGE_IDENTITY:-$HOME/.config/slippios/release-age.key}"
local_key="$HOME/.config/slippios/secureboot/slippios.key"
local_cert="$HOME/.config/slippios/secureboot/slippios.crt"
public_cert="$repo_root/secure-boot/slippios.crt"
secrets_store="$HOME/.secrets"
sb_key_secret="$secrets_store/slippios-sb-key.age"
sb_cert_secret="$secrets_store/slippios-sb-cert.age"
release_age_secret="$secrets_store/release-age.age"

mode="signing"
force_vault=0
work=""

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/with-release-secrets [--vault] <command> [args...]
  scripts/with-release-secrets [--vault] --check
  scripts/with-release-secrets --publish <command> [args...]

  --vault    Ignore a local key and decrypt from the release-secrets vault.
  --publish  Load publish credentials instead of the Secure Boot key.
  --check    Verify the key matches secure-boot/slippios.crt and print its
             SHA-256 fingerprint. Needs no command.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --publish) mode="publish"; shift ;;
    --check) mode="check"; shift ;;
    --vault) force_vault=1; shift ;;
    --) shift; break ;;
    -h|--help) usage; exit 0 ;;
    *) break ;;
  esac
done

if [[ $# -eq 0 && "$mode" != "check" ]]; then
  usage
  exit 2
fi

cleanup() {
  if [[ -n "$work" ]]; then
    rm -rf "$work"
  fi
}
trap cleanup EXIT

need_tmp() {
  if [[ -n "$work" ]]; then
    return
  fi
  local base="${XDG_RUNTIME_DIR:-}"
  if [[ -z "$base" || ! -d "$base" || ! -w "$base" ]]; then
    if [[ -d /dev/shm && -w /dev/shm ]]; then
      base="/dev/shm"
    else
      base="${TMPDIR:-/tmp}"
    fi
  fi
  work="$(mktemp -d "$base/slippios-release.XXXXXX")"
  chmod 700 "$work"
}

require_age() {
  command -v age >/dev/null 2>&1 || {
    echo "age is required to decrypt $secrets_dir" >&2
    exit 1
  }
}

secret_get_to() {
  local name="$1" dest="$2"
  command -v secret-get >/dev/null 2>&1 || {
    echo "secret-get is required to read $secrets_store/$name.age" >&2
    exit 1
  }
  secret-get "$name" > "$dest"
  chmod 600 "$dest"
}

require_identity() {
  if [[ -f "$identity" ]]; then
    return
  fi

  # Personal machines may keep the release identity only in the chezmoi
  # ~/.secrets vault. Decrypt it into the same tmpfs as the signing key.
  if [[ -z "${SLIPPIOS_RELEASE_AGE_IDENTITY:-}" && -f "$release_age_secret" ]]; then
    need_tmp
    secret_get_to "release-age" "$work/release-age.key"
    identity="$work/release-age.key"
    return
  fi

  cat >&2 <<EOF
Release age identity not found: $identity

Generate one on this machine with:
  umask 077
  age-keygen -o "$identity"
  age-keygen -y "$identity"

Send the public key to an existing release manager and ask them to add it to
SlippiOS/release-secrets. Store the private identity in your password manager.
EOF
  exit 1
}

decrypt_to() {
  local source="$1" dest="$2"
  age --decrypt --identity "$identity" --output "$dest" "$source"
  chmod 600 "$dest"
}

pick_cert() {
  if [[ -n "${SLIPPIOS_SB_CERT:-}" ]]; then
    [[ -f "$SLIPPIOS_SB_CERT" ]] || {
      echo "SLIPPIOS_SB_CERT does not exist: $SLIPPIOS_SB_CERT" >&2
      exit 1
    }
    return
  fi
  if [[ -f "$local_cert" ]]; then
    export SLIPPIOS_SB_CERT="$local_cert"
  elif [[ -f "$public_cert" ]]; then
    export SLIPPIOS_SB_CERT="$public_cert"
  elif [[ -f "$sb_cert_secret" ]]; then
    need_tmp
    secret_get_to "slippios-sb-cert" "$work/slippios.crt"
    export SLIPPIOS_SB_CERT="$work/slippios.crt"
  else
    echo "No Secure Boot certificate found at $local_cert or $public_cert" >&2
    exit 1
  fi
}

load_signing() {
  if [[ "$force_vault" -eq 0 && -n "${SLIPPIOS_SB_KEY:-}" ]]; then
    [[ -f "$SLIPPIOS_SB_KEY" ]] || {
      echo "SLIPPIOS_SB_KEY does not exist: $SLIPPIOS_SB_KEY" >&2
      exit 1
    }
    pick_cert
    return
  fi

  if [[ "$force_vault" -eq 0 && -f "$local_key" ]]; then
    export SLIPPIOS_SB_KEY="$local_key"
    pick_cert
    return
  fi

  if [[ "$force_vault" -eq 0 && -f "$sb_key_secret" ]]; then
    need_tmp
    secret_get_to "slippios-sb-key" "$work/slippios.key"
    export SLIPPIOS_SB_KEY="$work/slippios.key"
    pick_cert
    return
  fi

  local encrypted="$secrets_dir/secureboot/slippios.key.age"
  if [[ ! -f "$encrypted" ]]; then
    cat >&2 <<EOF
No Secure Boot signing key found.

Set SLIPPIOS_SB_KEY and SLIPPIOS_SB_CERT, install the key at
$local_key, keep the chezmoi copy at $sb_key_secret, or clone the
private release-secrets vault at $secrets_dir.

See secure-boot/README.md.
EOF
    exit 1
  fi

  require_age
  require_identity
  need_tmp
  decrypt_to "$encrypted" "$work/slippios.key"
  export SLIPPIOS_SB_KEY="$work/slippios.key"
  pick_cert
}

load_publish() {
  if [[ -z "${SLIPPIOS_R2_ENV:-}" && -f "$secrets_dir/r2.env.age" ]]; then
    require_age
    require_identity
    need_tmp
    decrypt_to "$secrets_dir/r2.env.age" "$work/r2.env"
    export SLIPPIOS_R2_ENV="$work/r2.env"
  fi

  if [[ -z "${SF_USER:-}" && -f "$secrets_dir/sourceforge.env.age" ]]; then
    require_age
    require_identity
    need_tmp
    decrypt_to "$secrets_dir/sourceforge.env.age" "$work/sourceforge.env"
    set -a
    # shellcheck disable=SC1090
    . "$work/sourceforge.env"
    set +a
  fi

  if [[ -z "${SF_KEY:-}" ]]; then
    if [[ -f "$secrets_dir/sourceforge-ssh-key.age" ]]; then
      require_age
      require_identity
      need_tmp
      decrypt_to "$secrets_dir/sourceforge-ssh-key.age" "$work/sourceforge_ssh"
      export SF_KEY="$work/sourceforge_ssh"
    elif [[ -f "$secrets_store/sourceforge-ssh-key.age" ]]; then
      need_tmp
      secret_get_to "sourceforge-ssh-key" "$work/sourceforge_ssh"
      export SF_KEY="$work/sourceforge_ssh"
    fi
  fi
}

check_signing() {
  command -v openssl >/dev/null 2>&1 || {
    echo "openssl is required for --check" >&2
    exit 1
  }

  local key_mod cert_mod
  key_mod="$(openssl rsa -in "$SLIPPIOS_SB_KEY" -noout -modulus 2>/dev/null || true)"
  cert_mod="$(openssl x509 -in "$SLIPPIOS_SB_CERT" -noout -modulus 2>/dev/null || true)"
  if [[ -z "$key_mod" || "$key_mod" != "$cert_mod" ]]; then
    echo "Signing key does not match $SLIPPIOS_SB_CERT" >&2
    exit 1
  fi

  echo "Signing key matches the certificate."
  openssl x509 -in "$SLIPPIOS_SB_CERT" -noout -fingerprint -sha256
}

case "$mode" in
  signing)
    load_signing
    load_publish
    "$@"
    ;;
  publish)
    load_publish
    if [[ -z "${SLIPPIOS_R2_ENV:-}" && -z "${SF_KEY:-}" ]]; then
      echo "No publish credentials found in $secrets_dir" >&2
      exit 1
    fi
    "$@"
    ;;
  check)
    load_signing
    check_signing
    ;;
esac
