#!/usr/bin/env bash
# Download the newest successful SlippiOS ISO and install it for libvirt.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

DOMAIN="${SLIPPI_DOMAIN:-slippios-iso}"
DEST="${SLIPPI_IMAGE:-/var/lib/libvirt/images/slippios.iso}"
RESTART=0
ASSUME_YES=0
DRY_RUN=0
OFFLINE=0

usage() {
  cat <<'USAGE'
usage: scripts/sync-iso [--restart] [--yes] [--offline] [--dry-run] [--domain NAME] [--dest PATH]

Downloads the ISO from the newest successful "Build ISO" run, verifies its
SHA-256, and installs it at the libvirt image path. With --restart it also
swaps the VM's CD-ROM and reboots or starts the domain.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --restart) RESTART=1 ;;
    -y|--yes) ASSUME_YES=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --offline) OFFLINE=1 ;;
    --domain) DOMAIN="${2:?missing domain}"; shift ;;
    --dest) DEST="${2:?missing destination}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v gh >/dev/null || { echo "gh is required" >&2; exit 1; }
command -v curl >/dev/null || { echo "curl is required" >&2; exit 1; }

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
fields='databaseId,headSha,status,conclusion,createdAt'

latest_row=$(
  gh run list --repo "$repo" --workflow "Build ISO" --limit 1 \
    --json "$fields" \
    -q '.[0] | [.databaseId, .headSha, .status, (.conclusion | if . == "" then "none" else . end), .createdAt] | @tsv'
)
IFS=$'\t' read -r latest_id latest_sha latest_status latest_conclusion latest_created <<<"$latest_row"

success_row=$(
  gh run list --repo "$repo" --workflow "Build ISO" --status success --limit 1 \
    --json "$fields" \
    -q '.[0] | [.databaseId, .headSha, .status, .conclusion, .createdAt] | @tsv'
)
IFS=$'\t' read -r success_id success_sha _success_status _success_conclusion success_created <<<"$success_row"

if [[ -z "${latest_id:-}" || "$latest_id" == "null" ]]; then
  echo "no Build ISO runs found" >&2
  exit 1
fi

if [[ "$latest_status" == "completed" && "$latest_conclusion" == "success" ]]; then
  run_id=$latest_id
  commit=$latest_sha
  created=$latest_created
else
  note=""
  [[ "$latest_conclusion" != "none" ]] && note=" ($latest_conclusion)"
  echo "Newest run $latest_id is ${latest_status}${note}." >&2
  echo "  commit ${latest_sha:0:7}, started $latest_created" >&2

  if [[ -z "${success_id:-}" || "$success_id" == "null" ]]; then
    echo "No successful Build ISO run is available yet." >&2
    exit 1
  fi

  echo "Most recent successful run: $success_id (commit ${success_sha:0:7}, $success_created)" >&2

  if [[ "$ASSUME_YES" -eq 0 && -t 0 ]]; then
    read -r -p "Use that run? [Y/n] " answer
    case "${answer:-y}" in
      y|Y|yes|YES) ;;
      *) echo "aborted" >&2; exit 1 ;;
    esac
  fi

  run_id=$success_id
  commit=$success_sha
  created=$success_created
fi

echo "Run:    $run_id"
echo "Commit: ${commit:0:7} ($created)"

log=$(gh run view "$run_id" --repo "$repo" --log)
url=$(grep -o 'Download: https://[^[:space:]]*' <<<"$log" | head -1 \
      | sed -E 's/^Download: //; s/\x1b\[[0-9;]*m//g' | tr -d '\r' || true)
hash=$(grep -o 'SHA256: [0-9a-f]\{64\}' <<<"$log" | head -1 | awk '{print $2}' || true)

if [[ -z "${url:-}" ]]; then
  echo "no download URL in run $run_id (upload may have failed)" >&2
  exit 1
fi

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "URL:    $url"
  echo "dry run: not downloading"
  exit 0
fi

cache="${XDG_CACHE_HOME:-$HOME/.cache}/slippios"
mkdir -p "$cache"
partial="$cache/$(basename "$url")"

echo "URL:    $url"
echo "Cache:  $partial"

cached_ok=0
if [[ -f "$partial" && -n "${hash:-}" ]] && \
   echo "$hash  $partial" | sha256sum --check - >/dev/null 2>&1; then
  cached_ok=1
  echo "Using cached ISO."
fi

if [[ "$cached_ok" -eq 0 ]]; then
  if [[ -f "$partial" && -n "${hash:-}" ]]; then
    echo "Cached file is incomplete or corrupt; starting over." >&2
    rm -f "$partial"
  fi

  if [[ "$OFFLINE" -eq 1 ]]; then
    echo "offline: no verified cached ISO for this run" >&2
    exit 1
  fi

  avail_kb=$(df -Pk "$cache" | awk 'NR == 2 { print $4 }')
  if (( avail_kb < 3500000 )); then
    echo "not enough space in $cache (need ~3.5 GB, have $((avail_kb / 1024)) MB)" >&2
    exit 1
  fi

  if ! curl --fail --location --progress-bar --continue-at - -o "$partial" "$url"; then
    echo "download failed; partial file kept for resume: $partial" >&2
    exit 1
  fi

  if [[ -n "${hash:-}" ]]; then
    echo "$hash  $partial" | sha256sum --check -
  else
    echo "warning: no SHA-256 in the run log; skipping verification" >&2
  fi
fi

sudo install -m 0444 "$partial" "$DEST"
if command -v restorecon >/dev/null 2>&1; then
  sudo restorecon -v "$DEST" || true
fi
echo "Installed: $DEST"

if [[ "$RESTART" -eq 1 ]]; then
  if ! sudo virsh -c qemu:///system dominfo "$DOMAIN" >/dev/null 2>&1; then
    echo "domain '$DOMAIN' does not exist; ISO installed only" >&2
    exit 0
  fi

  target=$(sudo virsh -c qemu:///system domblklist "$DOMAIN" --details \
           | awk '$2 == "cdrom" { print $3; exit }')
  if [[ -n "${target:-}" ]]; then
    if ! sudo virsh -c qemu:///system change-media "$DOMAIN" "$target" \
         --update --force "$DEST"; then
      echo "warning: could not switch the CD-ROM" >&2
    fi
  fi

  if sudo virsh -c qemu:///system domstate "$DOMAIN" | grep -q running; then
    sudo virsh -c qemu:///system reboot "$DOMAIN" || {
      sudo virsh -c qemu:///system destroy "$DOMAIN"
      sudo virsh -c qemu:///system start "$DOMAIN"
    }
  else
    sudo virsh -c qemu:///system start "$DOMAIN"
  fi
  echo "Domain '$DOMAIN' restarted with the new ISO"
fi
