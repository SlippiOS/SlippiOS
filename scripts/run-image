#!/usr/bin/env bash
# Boot a SlippiOS USB image in QEMU with UEFI and a writable overlay.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}"
DISK_SIZE="${SLIPPI_DISK_SIZE:-16G}"
DISK_MODE="${SLIPPI_DISK:-virtio}"
DISPLAY_MODE="${SLIPPI_DISPLAY:-gtk}"
IMAGE="${1:-}"

usage() {
  cat <<'USAGE'
usage: scripts/run-image [IMAGE.raw|IMAGE.raw.xz]

Boots a local SlippiOS USB image under OVMF/QEMU. Without an argument,
uses the newest artifact in result-local-image/.

Environment:
  SLIPPI_DISK        virtio (default, fast) or usb (tests the USB path)
  SLIPPI_DISK_SIZE   virtual disk size (default 16G)
  SLIPPI_DISPLAY     QEMU display backend (default gtk, use none for headless)
  SLIPPI_VGA         std (default) or virtio (DRM/KMS like real hardware)
  SLIPPI_OVMF_DIR    directory holding the UEFI code/vars firmware
  SLIPPI_SECURE_BOOT 1 to use OVMF Secure Boot firmware and vars
  SLIPPI_SSH_PORT    host port forwarded to the dev VM's SSH (default 2222)
  SLIPPI_MONITOR     QEMU monitor socket (default ~/.cache/slippios/<id>.sock)

Closing the QEMU window is a hard power cut. Power off from the shell
(Quit -> Power off) or run 'mise run stop:image' for a clean shutdown.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ -z "$IMAGE" ]]; then
  IMAGE=$(find -L result-local-image -maxdepth 1 \
    \( -name '*.raw' -o -name '*.raw.xz' \) \
    ! -name '*.nix-store.raw' ! -name '*.nix-store.raw.xz' \
    -print -quit 2>/dev/null || true)
  if [[ -z "$IMAGE" ]]; then
    echo "no image found; run 'mise run build:image' first" >&2
    exit 1
  fi
fi

if [[ ! -r "$IMAGE" ]]; then
  echo "cannot read image: $IMAGE" >&2
  exit 1
fi

needs_shell=0
command -v qemu-img >/dev/null 2>&1 || needs_shell=1
command -v qemu-system-x86_64 >/dev/null 2>&1 || needs_shell=1
if [[ "$IMAGE" == *.xz ]] && ! command -v xz >/dev/null 2>&1; then
  needs_shell=1
fi

if (( needs_shell )); then
  if [[ "${SLIPPI_IN_NIX:-0}" != "1" ]]; then
    exec env SLIPPI_IN_NIX=1 \
      ./scripts/nix shell --inputs-from . nixpkgs#qemu nixpkgs#xz \
      -c "$PWD/scripts/run-image" "$@"
  fi
  echo "qemu-img, qemu-system-x86_64, and xz are required" >&2
  exit 1
fi

mkdir -p "$CACHE"
image_id=$(sha256sum "$IMAGE" | cut -c1-12)
if [[ "$IMAGE" == *.xz ]]; then
  raw="$CACHE/$(basename "${IMAGE%.xz}")-${image_id}.raw"
  if [[ ! -f "$raw" ]]; then
    echo "Decompressing $IMAGE"
    # BusyBox xz (e.g. nix-portable's) has no -T/--threads option.
    xz_args=(-d -c)
    if xz --help 2>&1 | grep -q -- '-T'; then
      xz_args=(-d -T0 -c)
    fi
    xz "${xz_args[@]}" "$IMAGE" > "$raw.tmp"
    mv "$raw.tmp" "$raw"
  fi
else
  raw=$(realpath "$IMAGE")
fi

overlay="$CACHE/slippios-${image_id}.qcow2"
if [[ ! -f "$overlay" ]]; then
  qemu-img create -f qcow2 -F raw -b "$raw" "$overlay" "$DISK_SIZE"
fi

secure_boot="${SLIPPI_SECURE_BOOT:-0}"
# Prefer the distro's OVMF names, then QEMU's bundled EDK2 blobs (which need
# no separate firmware package). Each code file pairs with its vars template.
if [[ "$secure_boot" == "1" ]]; then
  code_names=(OVMF_CODE.secboot.fd edk2-x86_64-secure-code.fd)
  vars_names=(OVMF_VARS.secboot.fd edk2-i386-vars.fd)
else
  code_names=(OVMF_CODE.fd edk2-x86_64-code.fd)
  vars_names=(OVMF_VARS.fd edk2-i386-vars.fd)
fi

qemu_share="$(dirname "$(dirname "$(command -v qemu-system-x86_64)")")/share/qemu"
candidate_dirs=()
[[ -n "${SLIPPI_OVMF_DIR:-}" ]] && candidate_dirs+=("$SLIPPI_OVMF_DIR")
candidate_dirs+=("$qemu_share" /usr/share/OVMF /usr/share/edk2/ovmf
  /usr/share/edk2/ovmf/x64 /usr/share/edk2/x64 /usr/share/edk2/x86_64
  /usr/share/edk2-ovmf /usr/share/edk2-ovmf/x64 /usr/share/qemu)

code=""
vars=""
for i in "${!code_names[@]}"; do
  for prefix in "${candidate_dirs[@]}"; do
    if [[ -f "$prefix/${code_names[$i]}" && -f "$prefix/${vars_names[$i]}" ]]; then
      code="$prefix/${code_names[$i]}"
      vars="$prefix/${vars_names[$i]}"
      break 2
    fi
  done
done
if [[ -z "$code" ]]; then
  echo "UEFI firmware not found; install edk2-ovmf/ovmf or set SLIPPI_OVMF_DIR" >&2
  exit 1
fi

vars_copy="$CACHE/OVMF_VARS-$(basename "$raw")-${secure_boot}.fd"
if [[ ! -f "$vars_copy" ]]; then
  cp "$vars" "$vars_copy"
fi
# Nix store firmware is read-only; QEMU needs a writable vars image.
chmod u+w "$vars_copy"

accel="tcg"
cpu="max"
if [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]]; then
  accel="kvm"
  cpu="host"
fi

serial_args=()
if [[ -n "${SLIPPI_SERIAL:-}" ]]; then
  serial_args=(-serial "file:${SLIPPI_SERIAL}")
fi
monitor="${SLIPPI_MONITOR:-$CACHE/slippios-${image_id}.sock}"
rm -f "$monitor"
monitor_args=(-monitor "unix:${monitor},server,nowait")

vga_args=(-vga std)
if [[ "${SLIPPI_VGA:-std}" == "virtio" ]]; then
  vga_args=(-vga none -device virtio-gpu-pci)
fi

disk_args=()
if [[ "$DISK_MODE" == "usb" ]]; then
  disk_args=(
    -device qemu-xhci
    -drive if=none,id=usbstick,file="$overlay",format=qcow2
    -device usb-storage,drive=usbstick,bootindex=0
  )
else
  disk_args=(
    -drive if=none,id=disk,file="$overlay",format=qcow2
    -device virtio-blk-pci,drive=disk,bootindex=0
  )
fi

echo "Image:   $raw"
echo "Overlay: $overlay ($DISK_SIZE)"
echo "Disk:    $DISK_MODE"
echo "Display: $DISPLAY_MODE"
echo "Monitor: $monitor"
echo "Network: host port 8080 is forwarded; from this PC use http://localhost:8080/<token>/"
echo "SSH:     ssh -p ${SLIPPI_SSH_PORT:-2222} player@localhost (dev image, password: slippios)"
exec qemu-system-x86_64 \
  -machine "q35,accel=$accel" \
  -cpu "$cpu" \
  -m 4096 -smp 4 \
  -drive if=pflash,format=raw,readonly=on,file="$code" \
  -drive if=pflash,format=raw,file="$vars_copy" \
  "${disk_args[@]}" \
  -nic "user,model=virtio-net-pci,hostfwd=tcp::8080-:8080,hostfwd=tcp::${SLIPPI_SSH_PORT:-2222}-:22" \
  "${vga_args[@]}" \
  "${serial_args[@]}" \
  "${monitor_args[@]}" \
  -display "$DISPLAY_MODE"
