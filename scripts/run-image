#!/usr/bin/env bash
# Boot a SlippiOS USB image in QEMU with UEFI and a writable overlay.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}"
DISK_SIZE="${SLIPPI_DISK_SIZE:-16G}"
DISK_MODE="${SLIPPI_DISK:-virtio}"
DISPLAY_MODE="${SLIPPI_DISPLAY:-gtk}"
IMAGE="${1:-}"

usage() {
  cat <<'USAGE'
usage: scripts/run-image [IMAGE.raw|IMAGE.raw.xz]

Boots a local SlippiOS USB image under OVMF/QEMU. Without an argument,
uses the newest artifact in result-local-image/.

Environment:
  SLIPPI_DISK        virtio (default, fast) or usb (tests the USB path)
  SLIPPI_DISK_SIZE   virtual disk size (default 16G)
  SLIPPI_DISPLAY     QEMU display backend (default gtk, use none for headless)
  SLIPPI_VGA         std (default) or virtio (DRM/KMS like real hardware)
  SLIPPI_SSH_PORT    host port forwarded to the dev VM's SSH (default 2222)
  SLIPPI_MONITOR     QEMU monitor socket (default ~/.cache/slippios/<id>.sock)

Closing the QEMU window is a hard power cut. Power off from the shell
(Quit -> Power off) or run 'mise run stop:image' for a clean shutdown.
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ -z "$IMAGE" ]]; then
  IMAGE=$(find -L result-local-image -maxdepth 1 \
    \( -name '*.raw' -o -name '*.raw.xz' \) \
    ! -name '*.nix-store.raw' ! -name '*.nix-store.raw.xz' \
    -print -quit 2>/dev/null || true)
  if [[ -z "$IMAGE" ]]; then
    echo "no image found; run 'mise run build:image' first" >&2
    exit 1
  fi
fi

if [[ ! -r "$IMAGE" ]]; then
  echo "cannot read image: $IMAGE" >&2
  exit 1
fi

command -v qemu-img >/dev/null || { echo "qemu-img is required" >&2; exit 1; }
command -v qemu-system-x86_64 >/dev/null || {
  echo "qemu-system-x86_64 is required" >&2
  exit 1
}

mkdir -p "$CACHE"
image_id=$(sha256sum "$IMAGE" | cut -c1-12)
if [[ "$IMAGE" == *.xz ]]; then
  raw="$CACHE/$(basename "${IMAGE%.xz}")-${image_id}.raw"
  if [[ ! -f "$raw" ]]; then
    echo "Decompressing $IMAGE"
    xz -d -T0 -c "$IMAGE" > "$raw.tmp"
    mv "$raw.tmp" "$raw"
  fi
else
  raw=$(realpath "$IMAGE")
fi

overlay="$CACHE/slippios-${image_id}.qcow2"
if [[ ! -f "$overlay" ]]; then
  qemu-img create -f qcow2 -F raw -b "$raw" "$overlay" "$DISK_SIZE"
fi

code=""
vars=""
for prefix in /usr/share/OVMF /usr/share/edk2/ovmf /usr/share/edk2-ovmf /usr/share/qemu; do
  if [[ -f "$prefix/OVMF_CODE.fd" && -f "$prefix/OVMF_VARS.fd" ]]; then
    code="$prefix/OVMF_CODE.fd"
    vars="$prefix/OVMF_VARS.fd"
    break
  fi
done
if [[ -z "$code" ]]; then
  echo "OVMF firmware not found; install edk2-ovmf/ovmf" >&2
  exit 1
fi

vars_copy="$CACHE/OVMF_VARS-$(basename "$raw").fd"
if [[ ! -f "$vars_copy" ]]; then
  cp "$vars" "$vars_copy"
fi

accel="tcg"
cpu="max"
if [[ -c /dev/kvm && -r /dev/kvm && -w /dev/kvm ]]; then
  accel="kvm"
  cpu="host"
fi

serial_args=()
if [[ -n "${SLIPPI_SERIAL:-}" ]]; then
  serial_args=(-serial "file:${SLIPPI_SERIAL}")
fi
monitor="${SLIPPI_MONITOR:-$CACHE/slippios-${image_id}.sock}"
rm -f "$monitor"
monitor_args=(-monitor "unix:${monitor},server,nowait")

vga_args=(-vga std)
if [[ "${SLIPPI_VGA:-std}" == "virtio" ]]; then
  vga_args=(-vga none -device virtio-gpu-pci)
fi

disk_args=()
if [[ "$DISK_MODE" == "usb" ]]; then
  disk_args=(
    -device qemu-xhci
    -drive if=none,id=usbstick,file="$overlay",format=qcow2
    -device usb-storage,drive=usbstick,bootindex=0
  )
else
  disk_args=(
    -drive if=none,id=disk,file="$overlay",format=qcow2
    -device virtio-blk-pci,drive=disk,bootindex=0
  )
fi

echo "Image:   $raw"
echo "Overlay: $overlay ($DISK_SIZE)"
echo "Disk:    $DISK_MODE"
echo "Display: $DISPLAY_MODE"
echo "Monitor: $monitor"
echo "Network: host port 8080 is forwarded; from this PC use http://localhost:8080/<token>/"
echo "SSH:     ssh -p ${SLIPPI_SSH_PORT:-2222} player@localhost (dev image, password: slippios)"
exec qemu-system-x86_64 \
  -machine "q35,accel=$accel" \
  -cpu "$cpu" \
  -m 4096 -smp 4 \
  -drive if=pflash,format=raw,readonly=on,file="$code" \
  -drive if=pflash,format=raw,file="$vars_copy" \
  "${disk_args[@]}" \
  -nic "user,model=virtio-net-pci,hostfwd=tcp::8080-:8080,hostfwd=tcp::${SLIPPI_SSH_PORT:-2222}-:22" \
  "${vga_args[@]}" \
  "${serial_args[@]}" \
  "${monitor_args[@]}" \
  -display "$DISPLAY_MODE"
