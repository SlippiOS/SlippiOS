#!/usr/bin/env bash
# Disable Secure Boot on the SlippiOS libvirt domain and start it.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

DOMAIN="${SLIPPI_DOMAIN:-slippios-iso}"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

if ! sudo virsh -c qemu:///system dominfo "$DOMAIN" >/dev/null 2>&1; then
  echo "domain '$DOMAIN' not found" >&2
  exit 1
fi

sudo virsh -c qemu:///system destroy "$DOMAIN" 2>/dev/null || true
sudo virsh -c qemu:///system dumpxml "$DOMAIN" > "$tmp"

python3 - "$tmp" <<'PY'
import sys
import xml.etree.ElementTree as ET
from pathlib import Path

path = Path(sys.argv[1])
tree = ET.parse(path)
root = tree.getroot()

os_element = root.find("os")
if os_element is None:
    raise SystemExit("os element missing")

# Explicit loader, so drop firmware autoselection.
os_element.attrib.pop("firmware", None)

firmware = os_element.find("firmware")
if firmware is None:
    firmware = ET.SubElement(os_element, "firmware")

for name in ("secure-boot", "enrolled-keys"):
    feature = firmware.find(f"feature[@name='{name}']")
    if feature is None:
        feature = ET.SubElement(firmware, "feature")
        feature.set("name", name)
    feature.set("enabled", "no")

loader = os_element.find("loader")
if loader is not None:
    loader.set("secure", "no")
    loader.text = "/usr/share/edk2/ovmf/OVMF_CODE_4M.qcow2"

nvram = os_element.find("nvram")
if nvram is not None:
    nvram.set("template", "/usr/share/edk2/ovmf/OVMF_VARS_4M.qcow2")

tree.write(path, encoding="unicode")
PY

verify() {
  python3 - "$1" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()
feature = root.find("./os/firmware/feature[@name='secure-boot']")
loader = root.find("./os/loader")
secure = feature is not None and feature.get("enabled") == "yes"
secboot_loader = loader is not None and "secboot" in (loader.text or "")
if secure or secboot_loader:
    raise SystemExit(1)
print("Secure Boot disabled in XML")
PY
}

verify "$tmp"

nvram=$(python3 - "$tmp" <<'PY'
import sys
import xml.etree.ElementTree as ET

root = ET.parse(sys.argv[1]).getroot()
element = root.find("./os/nvram")
print(element.text if element is not None and element.text else "")
PY
)

if [[ -n "$nvram" ]]; then
  sudo rm -f "$nvram" "${nvram%.*}.qcow2" "${nvram%.*}.fd"
fi

sudo virsh -c qemu:///system define "$tmp"

# Confirm libvirt did not re-enable Secure Boot during define.
sudo virsh -c qemu:///system dumpxml "$DOMAIN" > /tmp/slippios-check.xml
verify /tmp/slippios-check.xml
rm -f /tmp/slippios-check.xml

sudo virsh -c qemu:///system start "$DOMAIN"
