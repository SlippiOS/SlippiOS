#!/usr/bin/env bash
# Local development sandbox: run the CLI, setup page, or exported Godot shell
# against a throwaday /data tree without building a USB image.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}/dev"
DATA="$CACHE/data"
BIN="$CACHE/bin"

setup() {
  mkdir -p "$DATA/isos" "$DATA/system" "$DATA/users/default" "$BIN"
  if [[ ! -f "$DATA/isos/test-melee.iso" ]]; then
    ./scripts/make-test-iso "$DATA/isos/test-melee.iso" >/dev/null
  fi
  if [[ ! -f "$DATA/users/default/settings.toml" ]]; then
    cat > "$DATA/users/default/settings.toml" <<'TOML'
schema_version = 1

[game]
iso = "test-melee.iso"

[display]
refresh_hz = 60
resolution = "auto"
rate = ""
custom = ""

[audio]
sink = "auto"

[network]
ssid = ""
psk = ""

[dolphin]
backend = "Vulkan"
resolution = 3
aspect = 3
vsync = false
msaa = 1
audio_backend = "Cubeb"
audio_latency = 20
controller = "adapter"
profile = ""

[expert]
enabled = false

[slippi]
user_json = "slippi-user.json"
TOML
  fi
  ( cd backend && mise exec -- go build -o "$BIN/slippios" ./cmd/slippios )
  export SLIPPIOS_DATA="$DATA"
  export PATH="$BIN:$PATH"
}

case "${1:-env}" in
  env)
    setup
    echo "SLIPPIOS_DATA=$DATA"
    echo "CLI=$BIN/slippios"
    echo
    echo "Run:"
    echo "  mise run dev:cli -- status"
    echo "  mise run dev:web"
    echo "  mise run dev:shell"
    ;;
  cli)
    setup
    shift
    exec slippios "$@"
    ;;
  web)
    setup
    shift || true
    exec slippios net --token dev --port 8080 --mode setup "$@"
    ;;
  shell)
    setup
    export SLIPPIOS_AUTOPLAY=0 SLIPPIOS_SKIP_SPLASH=1
    echo "SLIPPIOS_DATA=$DATA"
    echo "Starting the exported shell on ${DISPLAY:-the current display}."
    echo "This needs working OpenGL; on non-NixOS hosts, use a dev image instead."
    exec ./scripts/nix run .#shell-export -- --rendering-driver opengl3 "$@"
    ;;
  iso)
    setup
    echo "$DATA/isos/test-melee.iso"
    ;;
  ssh)
    port="${SLIPPI_SSH_PORT:-2222}"
    echo "password: slippios"
    exec ssh -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null       player@localhost
    ;;
  push)
    setup
    port="${SLIPPI_SSH_PORT:-2222}"
    askpass="$CACHE/askpass"
    printf '#!/bin/sh\necho slippios\n' > "$askpass"
    chmod +x "$askpass"
    remote() {
      SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 setsid \
        ssh -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
        -o PubkeyAuthentication=no -o PreferredAuthentications=password \
        player@localhost "$@"
    }
    remote_ready() {
      for _ in $(seq 1 30); do
        if remote true 2>/dev/null; then return 0; fi
        sleep 1
      done
      return 1
    }

    echo "Building CLI..."
    # Static so the binary runs inside NixOS without the host's glibc loader.
    ( cd backend && CGO_ENABLED=0 mise exec -- go build -trimpath -o "$BIN/slippios" ./cmd/slippios )
    echo "Exporting shell..."
    ./scripts/nix build .#shell-export -o result-shell-export >/dev/null
    target=$(readlink result-shell-export)
    if [[ -d "$HOME/.nix-portable$target" ]]; then
      src="$HOME/.nix-portable$target"
    else
      src="$target"
    fi
    cp -f "$src/bin/slippios-shell" "$BIN/slippios-shell"
    chmod 0755 "$BIN/slippios" "$BIN/slippios-shell"

    if ! remote_ready; then
      echo "dev VM is not reachable on port $port (boot a dev image first)" >&2
      exit 1
    fi
    remote "mkdir -p /data/dev"
    # Upload beside the live binaries and rename: writing over a running
    # executable fails with ETXTBSY.
    SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 setsid \
      scp -P "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o PubkeyAuthentication=no -o PreferredAuthentications=password \
      "$BIN/slippios" player@localhost:/data/dev/slippios.new
    SSH_ASKPASS="$askpass" SSH_ASKPASS_REQUIRE=force DISPLAY=:0 setsid \
      scp -P "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
      -o PubkeyAuthentication=no -o PreferredAuthentications=password \
      "$BIN/slippios-shell" player@localhost:/data/dev/slippios-shell.new
    remote "mv -f /data/dev/slippios.new /data/dev/slippios && mv -f /data/dev/slippios-shell.new /data/dev/slippios-shell && chmod 0755 /data/dev/slippios /data/dev/slippios-shell"
    echo "Restarting the graphical session..."
    remote "sudo -n /run/current-system/sw/bin/systemctl restart display-manager"
    sleep 3
    echo "Pushed. Use 'mise run dev:ssh' for logs."
    ;;
  *)
    echo "usage: scripts/dev {env|cli|web|shell|iso|ssh|push} [args...]" >&2
    exit 2
    ;;
esac
