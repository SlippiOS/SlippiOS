#!/usr/bin/env bash
# Download the newest successful SlippiOS USB image and boot it in QEMU.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

CACHE="${SLIPPIOS_CACHE:-$PWD/.cache}"
DRY_RUN=0
OFFLINE=0
RUN=1
DISK_SIZE="${SLIPPI_DISK_SIZE:-16G}"

usage() {
  cat <<'USAGE'
usage: scripts/fetch-image [--offline] [--dry-run] [--no-run] [--disk-size SIZE]

Downloads the newest successful "Build Image" run, verifies its SHA-256,
decompresses it, and boots a writable qcow2 overlay in QEMU with OVMF.

The overlay starts at 16G by default so the SLIPPIOS partition can grow on
first boot. Use --disk-size to change it.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --offline) OFFLINE=1 ;;
    --dry-run) DRY_RUN=1 ;;
    --no-run) RUN=0 ;;
    --disk-size) DISK_SIZE="${2:?missing size}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v gh >/dev/null || { echo "gh is required" >&2; exit 1; }
command -v xz >/dev/null || { echo "xz is required" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq is required" >&2; exit 1; }

repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
tag=$(gh release view --repo "$repo" --json tagName -q .tagName)
if [[ -z "${tag:-}" || "$tag" == "null" ]]; then
  echo "no published release found" >&2
  exit 1
fi

mkdir -p "$CACHE"
manifest="$CACHE/manifest.json"
gh release download "$tag" --repo "$repo" --pattern manifest.json \
  --dir "$CACHE" --clobber

full_name=$(jq -r '.full_image.name' "$manifest")
hash=$(jq -r '.full_image.sha256' "$manifest")
release_url=$(gh release view "$tag" --repo "$repo" --json url -q .url)

if [[ -z "${full_name:-}" || "$full_name" == "null" || -z "${hash:-}" || "$hash" == "null" ]]; then
  echo "release manifest is missing full_image name/sha256" >&2
  exit 1
fi

echo "Release: $tag"
echo "URL:     $release_url"
echo "Image:   $full_name"
echo "SHA256:  $hash"

compressed="$CACHE/$full_name"
raw="$CACHE/$(basename "${compressed%.xz}")-${hash:0:12}.raw"

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "dry run: not downloading"
  exit 0
fi

if [[ -f "$compressed" ]] && echo "$hash  $compressed" | sha256sum --check - >/dev/null 2>&1; then
  echo "Using cached image."
elif [[ "$OFFLINE" -eq 1 ]]; then
  echo "offline: no verified cached image" >&2
  exit 1
else
  if [[ -f "$compressed" ]]; then
    echo "Cached file is incomplete or corrupt; starting over." >&2
    rm -f "$compressed"
  fi
  avail_kb=$(df -Pk "$CACHE" | awk 'NR == 2 { print $4 }')
  if (( avail_kb < 12000000 )); then
    echo "not enough space in $CACHE (need ~12 GB, have $((avail_kb / 1024)) MB)" >&2
    exit 1
  fi
  gh release download "$tag" --repo "$repo" --pattern "$full_name" \
    --dir "$CACHE" --clobber
  echo "$hash  $compressed" | sha256sum --check -
fi

if [[ ! -f "$raw" ]]; then
  echo "Decompressing image..."
  xz -d -T0 -c "$compressed" > "$raw.tmp"
  mv "$raw.tmp" "$raw"
fi

if [[ "$RUN" -eq 0 ]]; then
  echo "Image: $raw"
  exit 0
fi

echo "Booting $raw ($DISK_SIZE)"
SLIPPI_DISK_SIZE="$DISK_SIZE" exec "$(dirname "${BASH_SOURCE[0]}")/run-image" "$raw"
