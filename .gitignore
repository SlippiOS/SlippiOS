/result
/result-*
/dist/
__pycache__/
*.qcow2
*.raw

# Godot import cache (the image build imports the project fresh)
/apps/shell/.godot/
/apps/shell/**/*.import
/apps/shell/**/*.uid

# Project-local QEMU/build cache (never commit)
/.cache/

# Secure Boot private key. The public certificate is tracked; the private key
# lives in the private SlippiOS/release-secrets vault.
/secure-boot/*.key
/secure-boot/*.pem
